{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:app": "vite build --base ./",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "pis": "node pis/pis-server.cjs",
    "electron:dev": "npm run build:app && electron .",
    "electron:build": "npm run build:app && electron-builder --linux AppImage deb",
    "cap:add": "cap add android",
    "cap:sync": "npm run build:app && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "build": {
    "appId": "org.corerail.obu",
    "productName": "CORE OBU",
    "files": ["dist/**", "electron/**", "pis/**", "package.json"],
    "linux": { "category": "Utility", "target": ["AppImage", "deb"] }
  }
}
