# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WS_PORT=3001
PIS_PORT=8080

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railcon?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-change-in-production"
JWT_EXPIRES_IN="24h"

# CORS
CORS_ORIGIN="*"

# Logging
LOG_LEVEL="info"
