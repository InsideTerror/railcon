generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  pinHash   String   @map("pin_hash")
  forteId   String   @unique @map("forte_id")
  name      String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions      ActiveSession[]
  sentMessages  Message[] @relation("SentMessages")

  @@map("users")
}

enum Role {
  DRIVER
  DISPATCHER
  SYSADMIN
}

model Route {
  id          String   @id
  name        String
  description String?
  stops       RouteStop[]
  timetables  Timetable[]

  @@map("routes")
}

model Station {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  routeStops    RouteStop[]
  timetableStops TimetableStop[]

  @@map("stations")
}

model RouteStop {
  routeId           String
  stationId         String
  stopSequenceIndex Int    @map("stop_sequence_index")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([routeId, stationId])
  @@index([stopSequenceIndex])
  @@map("route_stops")
}

model Timetable {
  id          String   @id @default(cuid())
  routeId     String   @map("route_id")
  runNumber   String   @map("run_number")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  direction   Int      // 1 or 2
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  route       Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stops       TimetableStop[]
  sessions    ActiveSession[]

  @@map("timetables")
}

model TimetableStop {
  id                 String   @id @default(cuid())
  timetableId        String   @map("timetable_id")
  stationId          String   @map("station_id")
  stopSequenceIndex  Int      @map("stop_sequence_index")
  scheduledArrival   DateTime? @map("scheduled_arrival")
  scheduledDeparture DateTime? @map("scheduled_departure")

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  station   Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([timetableId, stopSequenceIndex])
  @@index([stationId])
  @@map("timetable_stops")
}

model ActiveSession {
  id               String       @id @default(cuid())
  clientId         String       @unique @map("client_id")
  driverId         String?      @map("driver_id")
  timetableId      String?      @map("timetable_id")
  currentStopIndex Int          @default(0) @map("current_stop_index")
  delayMinutes     Int          @default(0) @map("delay_minutes")
  status           SessionStatus @default(NON_ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  driver     User?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  timetable  Timetable? @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  messages   Message[]  @relation("ReceivedMessages")

  @@map("active_sessions")
}

enum SessionStatus {
  ACTIVE
  IDLE
  NON_ACTIVE
}

model Message {
  id                   String        @id @default(cuid())
  senderId             String?       @map("sender_id")
  receiverClientId     String        @map("receiver_client_id")
  content              String
  type                 MessageType
  timestamp            DateTime      @default(now())
  acknowledged         Boolean       @default(false)

  sender       User?          @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  receiver     ActiveSession  @relation("ReceivedMessages", fields: [receiverClientId], references: [clientId], onDelete: Cascade)

  @@index([receiverClientId])
  @@map("messages")
}

enum MessageType {
  STATUS
  DISPATCH_POPUP
  PANIC
}

model CannedOption {
  id            String           @id @default(cuid())
  category      CannedCategory
  label         String
  templateText  String           @map("template_text")
  displayOrder  Int              @map("display_order")

  @@map("canned_options")
}

enum CannedCategory {
  DRIVER_TO_DISPATCH
  PASSENGER_ANNOUNCEMENT
}
